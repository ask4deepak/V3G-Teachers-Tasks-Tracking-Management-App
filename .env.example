# ============================================================================
# Application Environment Configuration
# ============================================================================
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://web-production-d0b3a.up.railway.app

# ============================================================================
# PostgreSQL Database Connection
# ============================================================================
# Automatically provided by Railway when connected to Railway Postgres service.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# ============================================================================
# Session Security Secret
# ============================================================================
SESSION_SECRET=super-secret-session-key-v3g-teacher-task-tracking

# ============================================================================
# Gmail / Google Workspace SMTP Email Configuration
# ============================================================================
# Instructions to set up Gmail / Google Workspace credentials:
# 1. Enable 2-Step Verification on your Google Account / Google Workspace admin account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a new App Password (e.g., Name: "TaskTrack Pro").
# 4. Copy the generated 16-character password into SMTP_PASS below.
# 5. Set SMTP_USER to your Gmail or Workspace email (e.g. ask4deepak@gmail.com or admin@yourdomain.com).
#
# Variables to enter in Railway (Settings -> Variables) or in your local .env:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ask4deepak@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="TaskTrack Notifications" <ask4deepak@gmail.com>
